# Example environment variables for local development
# Copy to .env and adjust values before running docker compose

# Supabase project (Project Settings → API)
NUXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NUXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Cloudflare Turnstile site key (the public one; its secret key goes in Supabase → Auth → Attack Protection)
# Must be set whenever Supabase's Captcha protection is on, or the magic link can't be sent
NUXT_PUBLIC_TURNSTILE_SITE_KEY=

# Google Analytics 4 (nuxt-gtag). Leave empty locally; set the G-XXXX ID only in production
NUXT_PUBLIC_GTAG_ID=

# Nuxt / Nitro
NITRO_HOST=0.0.0.0
HOST=0.0.0.0
PORT=3000
