# Example environment variables for local development
# Copy to .env and adjust values before running docker-compose

# Postgres (for the db service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=meowgic_snap_dev

# Supabase placeholders (optional; used if connecting to a Supabase project)
NUXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NUXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
NUXT_SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Google Analytics 4 (nuxt-gtag). Leave empty locally; set the G-XXXX ID only in production
NUXT_PUBLIC_GTAG_ID=

# Nuxt / Nitro
NITRO_HOST=0.0.0.0
HOST=0.0.0.0
PORT=3000
